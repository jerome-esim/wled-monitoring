{
  "name": "led-shader-controller-backend",
  "version": "1.0.0",
  "description": "Backend server for LED Shader Controller with Art-Net support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "led",
    "artnet",
    "dmx",
    "shader",
    "wled"
  ],
  "author": "Jerome",
  "license": "MIT",
  "dependencies": {
    "artnet": "^1.4.0",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
